# --- LLM ---
LLM_PROVIDER=groq            # groq | mock
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b                # generowanie + ocena zrozumienia (free tier: 8k TPM / 1000 req/dzień)
GROQ_MODERATION_MODEL=openai/gpt-oss-safeguard-20b  # osobny limit TPM; puste = moderacja głównym modelem

# --- App ---
DATABASE_URL=sqlite:///./data/app.db   # na Vercelu: Supabase z Vercel Marketplace ustawia POSTGRES_URL (używany, gdy tu jest SQLite)
# POSTGRES_URL=postgres://...pooler.supabase.com:6543/postgres?sslmode=require
CORS_ORIGINS=http://localhost:5173
