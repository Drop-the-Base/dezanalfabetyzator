# --- LLM ---
LLM_PROVIDER=groq            # groq | mock
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile          # generowanie + ocena zrozumienia (sprawdzić dostępność na start)
GROQ_MODERATION_MODEL=meta-llama/llama-guard-4-12b  # opcjonalnie; puste = moderacja głównym modelem

# --- App ---
DATABASE_URL=sqlite:///./data/app.db
TEACHER_PIN=1234             # wejście do panelu nauczyciela na demo
CORS_ORIGINS=http://localhost:5173
